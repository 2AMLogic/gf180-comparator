{
  "schema_version": 1,
  "kind": "t1-attestation-inventory",
  "t1_item": 10,
  "description": "Repo hygiene: README, license, and the CI files plus the PDK-free verifiers that keep the harness and evidence formats valid. The steps exclude the signoff re-grade (it grades this attestation, so running it here would be circular).",
  "hygiene": [
    ".github/workflows/selftest.yml",
    ".github/workflows/signoff.yml",
    "LICENSE",
    "README.md",
    "scripts/check_bench_inventory.py",
    "scripts/check_claim_drift.py",
    "scripts/run-pdk-free-tests.sh",
    "signoff/check_klt_pin.py",
    "signoff/regenerate.sh",
    "signoff/verify-report.py"
  ],
  "checks": [
    {
      "name": "discovery",
      "argv": [
        "./scripts/run-pdk-free-tests.sh",
        "discovery"
      ]
    },
    {
      "name": "harness-tests",
      "argv": [
        "./scripts/run-pdk-free-tests.sh",
        "harness"
      ]
    },
    {
      "name": "klt-pin",
      "argv": [
        "./scripts/run-pdk-free-tests.sh",
        "klt-pin"
      ]
    },
    {
      "name": "rulebook-pin",
      "argv": [
        "./scripts/run-pdk-free-tests.sh",
        "rulebook-pin"
      ]
    },
    {
      "name": "bench-inventory",
      "argv": [
        "./scripts/run-pdk-free-tests.sh",
        "bench-inventory"
      ]
    },
    {
      "name": "claim-drift",
      "argv": [
        "./scripts/run-pdk-free-tests.sh",
        "claim-drift"
      ]
    }
  ]
}
