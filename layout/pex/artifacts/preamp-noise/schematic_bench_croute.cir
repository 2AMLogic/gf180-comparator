noise v(xdut.aop,xdut.aon) vd dec 20 1e3 1e9
ac dec 20 1 1e9
let m_hub_av_dc = mag(v(xdut.aop)-v(xdut.aon))[0]
let m_hub_onoise_uv = noise2.onoise_total*1e6
let m_hub_onoise_hf_uv = noise4.onoise_total*1e6
