vsup vdd 0 dc {vdd_val}
vcm  cm 0 dc {dut_vcm}
vd   vd 0 dc 0 ac 1
Eap  ap cm vd 0 0.5
Ean  an cm vd 0 -0.5
ib   vdd ibn dc {dut_ib}
* the WHOLE comparator, held in reset (clk low)
vclk clk 0 dc 0
Xdut ap an clk ibn dout doutb vdd 0 comparator_dut
Cwp xdut.aop 0 10f
Cwn xdut.aon 0 10f

.control
set numdgt=10
set noaskquit
op
