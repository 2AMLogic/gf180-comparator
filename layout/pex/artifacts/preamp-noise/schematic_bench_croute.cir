let m_hub_vn_in_hf_uv = noise4.onoise_total/m_hub_av_dc*1e6
let m_hub_inoise_band_uv = noise2.inoise_total*1e6
let m_hub_white_nv_rthz = noise1.onoise_spectrum[120]*1e9
let m_hub_enbw_mhz = (noise2.onoise_total^2)/(noise1.onoise_spectrum[120]^2)/1e6
print m_hub_av_dc
print m_hub_onoise_uv
print m_hub_onoise_hf_uv
