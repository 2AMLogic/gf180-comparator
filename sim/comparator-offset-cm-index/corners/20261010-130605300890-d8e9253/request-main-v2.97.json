    {
      "name": "xcm_up_2m",
      "spice": ".meas dc xcm_up_2m find v(xcm) at=5"
    },
    {
      "name": "xvd_up_2m",
      "spice": ".meas dc xvd_up_2m find v(vd) at=5"
    }
  ],
  "options": {
    "timeout_s": 3000,
    "keep_artifacts": true,
    "ngspice_init": [
      "set measureprec=12",
      "set numdgt=12"
    ]
  },
  "monte_carlo": {
    "n": 200,
    "seed": 20260909,
    "vary": "mismatch"
  }
}
