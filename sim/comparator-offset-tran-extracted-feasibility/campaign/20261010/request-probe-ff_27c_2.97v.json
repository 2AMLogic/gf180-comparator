{
  "netlist": "body-probe-ff_27c_2.97v.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_ff",
          "bjt_ff",
          "diode_ff",
          "moscap_ff",
          "mimcap_ff"
        ]
      }
    ],
    "temperature_c": [
      27.0
    ]
  },
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  },
  "analysis": {
    "kind": "tran",
    "args": "100n 80u 0 100n"
  },
  "measurements": [
    {
      "name": "t_flip",
      "spice": ".meas tran t_flip when v(dn)=0.5 rise=1 td=8u"
    },
    {
      "name": "vos_v",
      "spice": ".meas tran vos_v find v(rmp) when v(dn)=0.5 rise=1 td=8u"
    }
  ],
  "options": {
    "timeout_s": 3000,
    "keep_artifacts": true,
    "ngspice_init": [
      "set measureprec=12",
      "set numdgt=12"
    ]
  }
}
