{
  "netlist": "body-ss_125c_2.97v.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_ss",
          "bjt_ss",
          "diode_ss",
          "moscap_ss",
          "mimcap_ss"
