{
  "netlist": "body-v2.97.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_ff",
          "bjt_ff",
          "diode_ff",
          "moscap_ff",
          "mimcap_ff"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_ss",
          "bjt_ss",
          "diode_ss",
          "moscap_ss",
          "mimcap_ss"
        ]
      },
      {
        "name": "fs",
        "sections": [
          "fs",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "sf",
        "sections": [
          "sf",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      }
    ],
    "temperature_c": [
      -40.0,
      27.0,
      125.0
    ]
  },
  "batch": {
    "runner_version_check": "warn"
  },
  "analysis": {
    "kind": "tran",
    "args": "5p 60n"
  },
  "measurements": [
    {
      "name": "vsup_v",
      "spice": ".meas tran vsup_v find v(vdd) at=25n"
    },
    {
      "name": "td_a",
      "spice": ".meas tran td_a trig v(clkn) val=0.5 rise=2 targ v(dan) val=0.5 rise=1 td=35n"
    },
    {
      "name": "td_b",
      "spice": ".meas tran td_b trig v(clkn) val=0.5 rise=2 targ v(dbn) val=0.5 rise=1 td=35n"
    },
    {
      "name": "td_c",
      "spice": ".meas tran td_c trig v(clkn) val=0.5 rise=2 targ v(dcn) val=0.5 rise=1 td=35n"
    },
    {
      "name": "da_first",
      "spice": ".meas tran da_first find v(dan) at=18n"
    },
    {
      "name": "db_first",
      "spice": ".meas tran db_first find v(dbn) at=18n"
    },
    {
      "name": "dc_first",
      "spice": ".meas tran dc_first find v(dcn) at=18n"
    },
    {
      "name": "da_end",
      "spice": ".meas tran da_end find v(dan) at=55n"
    },
    {
      "name": "db_end",
      "spice": ".meas tran db_end find v(dbn) at=55n"
    },
    {
      "name": "dc_end",
      "spice": ".meas tran dc_end find v(dcn) at=55n"
    },
    {
      "name": "i_stat",
      "spice": ".meas tran i_stat avg i(vsupa) from=25n to=29n"
    },
    {
      "name": "q_dec",
      "spice": ".meas tran q_dec integ i(vsupa) from=39.9n to=48n"
    },
    {
      "name": "tdr_a",
      "spice": ".meas tran tdr_a trig v(clkn) val=0.5 rise=2 targ v(dran) val=0.5 fall=1 td=35n"
    },
    {
      "name": "tdr_b",
      "spice": ".meas tran tdr_b trig v(clkn) val=0.5 rise=2 targ v(drbn) val=0.5 fall=1 td=35n"
    },
    {
      "name": "tdr_c",
      "spice": ".meas tran tdr_c trig v(clkn) val=0.5 rise=2 targ v(drcn) val=0.5 fall=1 td=35n"
    },
    {
      "name": "dra_first",
      "spice": ".meas tran dra_first find v(dran) at=18n"
    },
    {
      "name": "drb_first",
      "spice": ".meas tran drb_first find v(drbn) at=18n"
    },
    {
      "name": "drc_first",
      "spice": ".meas tran drc_first find v(drcn) at=18n"
    },
    {
      "name": "dra_end",
      "spice": ".meas tran dra_end find v(dran) at=55n"
    },
    {
      "name": "drb_end",
      "spice": ".meas tran drb_end find v(drbn) at=55n"
    },
    {
      "name": "drc_end",
      "spice": ".meas tran drc_end find v(drcn) at=55n"
    }
  ],
  "options": {
    "timeout_s": 3000,
    "keep_artifacts": true,
    "ngspice_init": [
      "set measureprec=12",
      "set numdgt=12"
    ]
  }
}
